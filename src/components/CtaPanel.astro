---
import { site, childPriceLine } from "../config/site";

interface Props {
  heading?: string;
  compact?: boolean;
}

const { heading = "Seen enough?", compact = false } = Astro.props;
---

<aside class:list={["cta-banner", compact && "mt-10"]}>
  <span class="cta-banner-mark" aria-hidden="true">★</span>
  <div>
    <h2 class:list={[compact && "text-2xl"]}>{heading}</h2>
    <p>
      {site.hours.days}, three sittings, {site.play.durationLabel}. {childPriceLine()}. Adults go free.
    </p>
  </div>
  <a class="btn btn-primary btn-book-now" href="/book">BOOK NOW!</a>
</aside>
