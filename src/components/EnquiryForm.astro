---
interface Props {
  formName: string;
  submitLabel?: string;
  extraFields?: "party" | "none";
}

const { formName, submitLabel = "Send message", extraFields = "none" } = Astro.props;
---

<form name={formName} method="POST" action="/contact?sent=1" data-netlify="true" netlify-honeypot="bot-field" class="card">
  <input type="hidden" name="form-name" value={formName} />
  <input type="hidden" name="_redirect" value="/contact?sent=1" />
  <p class="honeypot">
    <label>
      Don’t fill this in
      <input name="bot-field" />
    </label>
  </p>

  <div class="form-field">
    <label for={`${formName}-name`}>Your name</label>
    <input id={`${formName}-name`} name="name" type="text" autocomplete="name" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-email`}>Email</label>
    <input id={`${formName}-email`} name="email" type="email" autocomplete="email" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-phone`}>Phone <span class="font-normal text-navy-muted">(optional)</span></label>
    <input id={`${formName}-phone`} name="phone" type="tel" autocomplete="tel" />
  </div>

  {
    extraFields === "party" && (
      <>
        <div class="form-field">
          <label for={`${formName}-child-age`}>Birthday child’s age</label>
          <input id={`${formName}-child-age`} name="child-age" type="text" required />
        </div>
        <div class="form-field">
          <label for={`${formName}-date`}>Preferred date</label>
          <input id={`${formName}-date`} name="preferred-date" type="text" />
        </div>
        <div class="form-field">
          <label for={`${formName}-children`}>Rough number of children</label>
          <input id={`${formName}-children`} name="children" type="text" inputmode="numeric" />
        </div>
      </>
    )
  }

  <div class="form-field">
    <label for={`${formName}-message`}>Message</label>
    <textarea id={`${formName}-message`} name="message" required></textarea>
  </div>

  <button type="submit" class="btn btn-primary">{submitLabel}</button>
  <p class="mt-3 text-sm text-navy-muted">We’ll only use this to reply to your enquiry.</p>
</form>
