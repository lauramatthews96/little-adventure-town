---
import PhotoFrame from "./PhotoFrame.astro";
import { townHighlights, zones, type Zone } from "../config/site";

interface Props {
  items?: Zone[];
}

const { items = zones } = Astro.props;

const fascia: Record<Zone["accent"], string> = {
  sea: "#1a90c8",
  sand: "#f05638",
  volcano: "#8e3428",
  castle: "#e91e6c",
  farm: "#a33b2c",
  space: "#1a2744",
};
---

<section aria-labelledby="town-heading" class="mt-14">
  <div class="town-sign">
    <div class="town-sign-top">
      <div>
        <p class="eyebrow">A town of little worlds</p>
        <h2 id="town-heading">Walk through town</h2>
      </div>
      <a class="town-sign-link" href="/whats-inside">See what’s inside</a>
    </div>
    <p class="town-sign-lede">
      Six handmade rooms, not a plastic frame. Wander from one little world to the next.
    </p>
    <ol class="town-legend" aria-label="What you can do in town">
      {
        townHighlights.map((item) => (
          <li>
            <a class="town-highlight" href={item.href}>
              <span class="town-highlight-emoji" aria-hidden="true">{item.emoji}</span>
              <span>{item.text}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="town-street-wrap">
    <ol class="town-street" tabindex="0" aria-label="Play zones along the town street" data-town-street>
      {
        items.map((zone, index) => (
          <li class="town-stop">
            <a href={`/whats-inside#${zone.id}`}>
              <article class="town-building" style={`--fascia: ${fascia[zone.accent]}`}>
                <div class="town-photo">
                  <PhotoFrame
                    src={zone.image}
                    placeholder={zone.placeholder}
                    alt=""
                    label={zone.name}
                    size={zone.photoSize}
                    aspect="4 / 3"
                  />
                </div>
                <div class="town-fascia">
                  <p class="text-sm font-bold uppercase tracking-wider text-navy-muted">
                    Stop {index + 1} · {zone.eyebrow}
                  </p>
                  <h3 class="mt-1">{zone.name}</h3>
                  <p class="mt-1 text-base text-navy-muted">{zone.summary}</p>
                </div>
              </article>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="town-scroll-cue" data-town-cue aria-hidden="true">
      <span>Scroll to view</span>
      <svg width="28" height="20" viewBox="0 0 28 20" fill="none">
        <path d="M2 10h22" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
        <path d="M16.5 3.5 24.5 10 16.5 16.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </p>
  </div>
</section>

<script>
  const street = document.querySelector("[data-town-street]");
  const cue = document.querySelector("[data-town-cue]");
  if (street instanceof HTMLElement && cue instanceof HTMLElement) {
    const hide = () => cue.classList.add("is-hidden");
    street.addEventListener("scroll", hide, { once: true, passive: true });
  }
</script>
