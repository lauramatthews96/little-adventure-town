---
import { isToConfirm, site } from "../config/site";

const gaId = isToConfirm(site.tracking.googleAnalyticsId) ? "" : site.tracking.googleAnalyticsId;
const pixelId = isToConfirm(site.tracking.metaPixelId) ? "" : site.tracking.metaPixelId;
---

<div
  class="cookie-banner"
  data-cookie-banner
  data-ga-id={gaId}
  data-pixel-id={pixelId}
  role="region"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-text"
  hidden
>
  <div class="cookie-banner-ribbon" aria-hidden="true"></div>
  <div class="cookie-banner-inner">
    <div class="cookie-banner-copy">
      <p class="cookie-banner-eyebrow">Cookies</p>
      <h2 id="cookie-banner-title" tabindex="-1">A quick word about cookies</h2>
      <p id="cookie-banner-text">
        Some keep the site working. Optional ones from Google Analytics and Facebook help us see how visits go, and whether our ads are working. You can say no. Read the
        {" "}
        <a href="/cookies">cookie policy</a>.
      </p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" class="btn btn-primary" data-cookie-accept>That’s fine</button>
      <button type="button" class="btn btn-secondary" data-cookie-reject>Essential only</button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = "lat-cookie-consent";

  type Consent = {
    v: number;
    analytics: boolean;
    ads: boolean;
  };

  const banner = document.querySelector("[data-cookie-banner]");
  if (banner instanceof HTMLElement) {
    const gaId = banner.dataset.gaId ?? "";
    const pixelId = banner.dataset.pixelId ?? "";

    const readConsent = (): Consent | null => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Consent;
        if (parsed?.v !== 1) return null;
        return parsed;
      } catch {
        return null;
      }
    };

    const saveConsent = (consent: Consent) => {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
    };

    const showBanner = () => {
      banner.hidden = false;
      document.documentElement.classList.add("show-cookie-banner");
    };

    const hideBanner = () => {
      banner.hidden = true;
      document.documentElement.classList.remove("show-cookie-banner");
    };

    const loadGoogleAnalytics = (id: string) => {
      if (!id || !/^G-[A-Z0-9]+$/i.test(id) || window.gtag) return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(...args: unknown[]) {
        window.dataLayer.push(args);
      };
      window.gtag("js", new Date());
      window.gtag("consent", "default", {
        analytics_storage: "granted",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });
      window.gtag("config", id, { anonymize_ip: true });
      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
      document.head.appendChild(script);
    };

    const loadMetaPixel = (id: string) => {
      if (!id || !/^\d+$/.test(id) || window.fbq) return;
      const fbq: MetaFbq = function (...args: unknown[]) {
        (fbq.q = fbq.q || []).push(args);
      };
      fbq.q = [];
      fbq.loaded = true;
      fbq.version = "2.0";
      window.fbq = fbq;
      window._fbq = fbq;
      const script = document.createElement("script");
      script.async = true;
      script.src = "https://connect.facebook.net/en_GB/fbevents.js";
      document.head.appendChild(script);
      window.fbq("init", id);
      window.fbq("track", "PageView");
    };

    const applyConsent = (consent: Consent) => {
      if (consent.analytics) loadGoogleAnalytics(gaId);
      else if (window.gtag) {
        window.gtag("consent", "update", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
        });
      }

      if (consent.ads) loadMetaPixel(pixelId);
      else if (window.fbq) window.fbq("consent", "revoke");
    };

    const existing = readConsent();
    if (existing) {
      applyConsent(existing);
      hideBanner();
    } else {
      showBanner();
    }

    banner.querySelector("[data-cookie-accept]")?.addEventListener("click", () => {
      const consent = { v: 1, analytics: true, ads: true };
      saveConsent(consent);
      applyConsent(consent);
      hideBanner();
    });

    banner.querySelector("[data-cookie-reject]")?.addEventListener("click", () => {
      const consent = { v: 1, analytics: false, ads: false };
      saveConsent(consent);
      applyConsent(consent);
      hideBanner();
    });

    document.querySelectorAll("[data-cookie-settings]").forEach((control) => {
      control.addEventListener("click", () => {
        showBanner();
        banner.querySelector("h2")?.focus();
      });
    });
  }

  type MetaFbq = ((...args: unknown[]) => void) & {
    q?: unknown[][];
    loaded?: boolean;
    version?: string;
  };

  declare global {
    interface Window {
      dataLayer: unknown[];
      gtag: (...args: unknown[]) => void;
      fbq: MetaFbq;
      _fbq: MetaFbq;
    }
  }
</script>
