---
import { footerNav, site, formatAddress } from "../config/site";
import FacebookIcon from "./FacebookIcon.astro";
import InstagramIcon from "./InstagramIcon.astro";
---

<footer class="site-footer mt-16 bg-cloud">
  <div class="site-ribbon" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3 md:px-6">
    <div>
      <p class="font-display text-2xl font-semibold">Little Adventure Town</p>
      <p class="mt-2 text-navy-muted">
        A handmade indoor adventure town on Newgate Street, for babies, toddlers and pre-schoolers.
      </p>
      <p class="mt-4">
        {formatAddress()}
      </p>
      <p class="mt-2">
        {site.hours.days}<br />
        {site.play.sessions.map((s) => s.label).join(" · ")}
      </p>
    </div>

    <div>
      <p class="font-display text-xl font-semibold">Find your way</p>
      <ul class="mt-3 space-y-2">
        {footerNav.map((item) => (
          <li>
            <a class="font-bold underline decoration-pink underline-offset-2 hover:decoration-navy" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-display text-xl font-semibold">Come and see us</p>
      <ul class="mt-3 space-y-2">
        <li>
          <a class="inline-flex items-center gap-1.5 font-bold underline decoration-meadow underline-offset-2 hover:decoration-navy" href={site.social.facebookUrl} target="_blank" rel="noopener noreferrer">
            <FacebookIcon />
            Facebook
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-1.5 font-bold underline decoration-pink underline-offset-2 hover:decoration-navy" href={site.social.instagramUrl} target="_blank" rel="noopener noreferrer">
            <InstagramIcon />
            Instagram
          </a>
        </li>
        <li>
          Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
      </ul>
      <p class="mt-6">
        <a class="btn btn-primary btn-book-now" href="/book">
          BOOK NOW! · {site.play.offer.active ? `September ${site.play.pricePerChild}` : site.play.pricePerChild}
        </a>
      </p>
    </div>
  </div>
  <div class="border-t border-navy/10">
    <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-navy-muted md:px-6">
      <p>© {new Date().getFullYear()} {site.legalName}.</p>
    </div>
  </div>
</footer>
