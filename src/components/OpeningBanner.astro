---
import { site } from "../config/site";
import FacebookIcon from "./FacebookIcon.astro";
---

<div class="bg-navy text-cloud">
  <p class="mx-auto max-w-6xl px-4 py-2 text-center text-sm md:text-base md:px-6">
    We open {site.opening.date}. Come and say hello on{" "}
    <a
      class="inline-flex items-center gap-1.5 font-bold underline underline-offset-2"
      href={site.social.facebookUrl}
      rel="noopener noreferrer"
    >
      <FacebookIcon />
      Facebook
    </a>{" "}
    for the latest.
  </p>
</div>
