---
import type { ZoneId } from "../config/site";

interface Props {
  id: ZoneId;
}

const { id } = Astro.props;
---

{
  id === "under-the-sea" && (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M14.2 8V4.1h3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M10.4 8.1h5.4v2.6h-5.4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M3.1 14c0-2.55 2.85-4.4 8.9-4.4s8.9 1.85 8.9 4.4-2.85 4.4-8.9 4.4-8.9-1.85-8.9-4.4Z" stroke="currentColor" stroke-width="1.7"></path>
      <circle cx="9.3" cy="14" r="1.15" fill="currentColor"></circle>
      <circle cx="13.6" cy="14" r="1.15" fill="currentColor"></circle>
      <path d="M3.1 12.4v3.2M2 11.7l2.4 1.35M2 16.3l2.4-1.35" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
    </svg>
  )
}
{
  id === "the-beach" && (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4.2 20.2h15.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      <path d="M5.2 20.2V13.4h2.1V11h1.8v2.4h2.1v6.8H5.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M11.8 20.2V11.2h2.3V8.4h2v2.8h2.3v8.8h-6.6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M16.1 8.4V3.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      <path d="M16.1 3.6h4.3l-1.35 1.45 1.35 1.5h-4.3" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
    </svg>
  )
}
{
  id === "dinosaur" && (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3.2 20.4 9.1 8.6h5.8l5.9 11.8H3.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M10.6 8.6c-.4-2.6 1.4-4.8 1.4-4.8.4 1.5 2.3 3.3 1.4 4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
      <circle cx="11.2" cy="4.7" r="1.15" fill="currentColor"></circle>
      <circle cx="13.7" cy="3.9" r="0.95" fill="currentColor"></circle>
      <circle cx="14.6" cy="6.2" r="0.8" fill="currentColor"></circle>
      <path d="M10.8 12.2c.35 2.3-.15 4.6-.2 6.4M14.4 12.6c.25 2.4.7 4.3.45 6" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
    </svg>
  )
}
{
  id === "the-castle" && (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M3.3 20.5V10.4h2.15V7.9h2.2v2.5h1.55V5.6h2.05V3.4h2.1V5.6h2.05v4.8h1.55V7.9h2.2v2.5h2.15v10.1H3.3Z"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
      ></path>
      <path d="M10.15 20.5v-5.1c0-1.85 3.7-1.85 3.7 0v5.1" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M14.15 5.6V2.9h4.15l-1.2 1.25 1.2 1.45h-4.15" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
    </svg>
  )
}
{
  id === "the-farm" && (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4.3 20.3V10.6c0-2.7 4.4-2.7 4.4 0v9.7" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M8.7 20.3V11.4L15.3 5.6l6.4 5.8v8.9H8.7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M12.3 20.3v-6.4h6.6v6.4" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M12.3 13.9 18.9 20.3M18.9 13.9 12.3 20.3" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
    </svg>
  )
}
{
  id === "space" && (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2.6c2.25 3.9 2.85 8.1 2.85 12.6H9.15C9.15 10.7 9.75 6.5 12 2.6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <circle cx="12" cy="9.4" r="1.45" fill="currentColor"></circle>
      <path d="M9.15 13.8 5.5 19.1l3.65-2.05M14.85 13.8 18.5 19.1l-3.65-2.05" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M10.25 16.7 12 21.3 13.75 16.7" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
    </svg>
  )
}
