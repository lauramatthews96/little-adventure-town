---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaPanel from "../components/CtaPanel.astro";
import PhotoFrame from "../components/PhotoFrame.astro";
import { formatAddress, site } from "../config/site";
---

<BaseLayout page="visit">
  <article class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-16">
    <PageHero eyebrow="County Durham" accent="teal" mark="★">
      <h1 slot="title">Visit us in Bishop Auckland</h1>
      <p>
        {site.address.line1}, {site.address.locality}, {site.address.postcode}. Right on the high street, former Bonmarché. You’re in town, not out at a shed on a ring road.
      </p>
    </PageHero>

    <div class="mt-8 max-w-3xl">
      <PhotoFrame
        src="/images/zones/town-windows.jpg"
        placeholder="/images/zones/town-windows.jpg"
        alt="The grass play floor by the high-street windows, with yellow chairs for grown-ups and toys for babies and toddlers."
        label="Little Adventure Town"
        size="1024 × 768"
        aspect="4 / 3"
      />
    </div>

    <div class="visit-grid">
      <section class="story-card" style="--story: var(--color-pink)" aria-labelledby="hours-heading">
        <h2 id="hours-heading">Opening hours</h2>
        <p>{site.hours.days}. Play sittings at {site.play.sessions.map((s) => s.label).join(", ")}.</p>
        <p class="mt-2">{site.hours.closed}.</p>
        <p class="mt-2">{site.hours.note} The café is walk-in when you get here.</p>
      </section>
      <section class="story-card" style="--story: var(--color-meadow)" aria-labelledby="park-heading">
        <h2 id="park-heading">Parking</h2>
        <p>
          Parking is on {site.parking.line1}, {site.parking.locality}, {site.parking.postcode}. We’re on Newgate Street in the town centre.
        </p>
        <p class="mt-2">
          <a class="font-bold underline underline-offset-2" href={site.parking.maps}>Open Tenters Street in Google Maps</a>.
        </p>
      </section>
      <section class="story-card" style="--story: var(--color-teal)" aria-labelledby="bring-heading">
        <h2 id="bring-heading">What to bring</h2>
        <ul class="mt-2 space-y-2">
          {site.whatToBring.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section class="story-card" style="--story: var(--color-gold)" aria-labelledby="rules-heading">
        <h2 id="rules-heading">The short version of the rules</h2>
        <ul class="mt-2 space-y-2">
          <li>Book first. No walk-in play.</li>
          <li>Socks on the play floor, grown-ups too.</li>
          <li>An adult stays with their child.</li>
          <li>Food and buggies: see the <a class="font-bold underline underline-offset-2" href="/house-rules">house rules</a>.</li>
        </ul>
      </section>
    </div>

    <section class="mt-10" aria-labelledby="map-heading">
      <div class="section-head" style="--section: var(--color-teal)">
        <span class="section-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <path d="M12 20.5s7-4.2 7-10.1A7 7 0 0 0 5 10.4C5 16.3 12 20.5 12 20.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
            <circle cx="12" cy="10.2" r="2.1" stroke="currentColor" stroke-width="1.8"></circle>
          </svg>
        </span>
        <div>
          <h2 id="map-heading">Map</h2>
          <p class="section-blurb">{formatAddress()}</p>
        </div>
      </div>
      <div class="map-frame">
        <iframe
          title="Map of Little Adventure Town on Newgate Street, Bishop Auckland"
          src={site.maps.embed}
          class="h-80 w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="mt-4 flex flex-wrap gap-4">
        <a class="font-bold underline underline-offset-2" href={site.maps.google}>Google Maps</a>
        <a class="font-bold underline underline-offset-2" href={site.maps.apple}>Apple Maps</a>
        <a class="font-bold underline underline-offset-2" href={site.maps.openStreetMap}>OpenStreetMap</a>
      </p>
    </section>

    <CtaPanel heading="Coming over?" />
  </article>
</BaseLayout>
