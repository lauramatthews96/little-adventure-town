---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PhotoFrame from "../components/PhotoFrame.astro";
import CtaPanel from "../components/CtaPanel.astro";
import ZoneIcon from "../components/ZoneIcon.astro";
import { zones } from "../config/site";
---

<BaseLayout page="whatsInside">
  <article class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-16">
    <PageHero eyebrow="Bishop Auckland" accent="meadow" mark="★">
      <h1 slot="title">What’s inside the town</h1>
      <p>You don’t go up a frame. You wander from one little world to the next.</p>
    </PageHero>

    <nav class="zone-chips" aria-label="Zones">
      {
        zones.map((zone) => (
          <a class="zone-chip" href={`#${zone.id}`}>
            <ZoneIcon id={zone.id} />
            {zone.shortName}
          </a>
        ))
      }
    </nav>

    <div class="mt-14 space-y-20">
      {
        zones.map((zone) => (
          <section id={zone.id} class="zone-chapter scroll-mt-28" aria-labelledby={`${zone.id}-heading`}>
            <div class="zone-photo">
              <PhotoFrame
                src={zone.image}
                placeholder={zone.placeholder}
                alt={zone.alt}
                label={zone.name}
                size={zone.photoSize}
                aspect="4 / 5"
              />
            </div>
            <div class="zone-copy">
              <p class="eyebrow">{zone.eyebrow}</p>
              <h2 id={`${zone.id}-heading`}>{zone.name}</h2>
              <p class="mt-4 text-lg">{zone.detail}</p>
              {zone.gallery.length > 0 && (
                <ul class="zone-extras">
                  {zone.gallery.map((shot) => (
                    <li>
                      <PhotoFrame
                        src={shot.src}
                        placeholder={shot.src}
                        alt={shot.alt}
                        label={zone.name}
                        size={zone.photoSize}
                        aspect="4 / 3"
                      />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        ))
      }
    </div>

    <CtaPanel heading="Seen enough? Book the sitting." />
  </article>
</BaseLayout>
