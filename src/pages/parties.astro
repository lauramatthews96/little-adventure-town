---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { site } from "../config/site";

const flags = ["pink", "sunshine", "meadow", "coral", "teal", "gold"] as const;

const included = [
  {
    title: `${site.parties.durationLabel} of the whole town`,
    detail: "Exclusive hire. The rooms are yours, not shared with another sitting.",
    icon: "clock",
  },
  {
    title: "A table in your theme",
    detail: "Dressed up for the birthday child, ready for the food and the chaos.",
    icon: "cake",
  },
  {
    title: "Food for every child",
    detail: "A sandwich box or a hot party tea. Grown-ups can use the café.",
    icon: "food",
  },
  {
    title: `Up to ${site.parties.includedChildren} children`,
    detail: `Extra children are ${site.parties.extraChildPrice} each, up to ${site.parties.maxChildren}.`,
    icon: "balloon",
  },
] as const;
---

<BaseLayout page="parties">
  <article class="party-page mx-auto max-w-4xl px-4 py-10 md:px-6 md:py-16">
    <div class="party-bunting" aria-hidden="true">
      {Array.from({ length: 14 }).map((_, i) => (
        <span class={`party-flag party-flag-${flags[i % flags.length]}`}></span>
      ))}
    </div>

    <header class="party-hero">
      <svg class="party-hat party-hat-left" width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true">
        <path d="M36 8 64 60H8L36 8Z" fill="#b3265a"></path>
        <path d="M36 8 50 34 22 34 36 8Z" fill="#e8b322"></path>
        <circle cx="36" cy="8" r="6" fill="#e8b322"></circle>
        <path d="M14 60h44c0 4.4-9.8 8-22 8s-22-3.6-22-8Z" fill="#1a2744"></path>
        <path d="M24 42h6M33 48h8M42 38h7" stroke="#fffcf6" stroke-width="3" stroke-linecap="round"></path>
      </svg>
      <svg class="party-balloon party-balloon-right" width="70" height="110" viewBox="0 0 70 110" fill="none" aria-hidden="true">
        <ellipse cx="28" cy="28" rx="18" ry="24" fill="#b3265a"></ellipse>
        <ellipse cx="48" cy="36" rx="14" ry="20" fill="#e8b322"></ellipse>
        <path d="M28 52c0 10-4 18 2 28" stroke="#1a2744" stroke-width="1.8"></path>
        <path d="M48 56c2 10-2 20 4 30" stroke="#1a2744" stroke-width="1.8"></path>
        <ellipse cx="22" cy="20" rx="4" ry="7" fill="#fffcf6" opacity="0.45"></ellipse>
      </svg>
      <p class="eyebrow">Birthdays</p>
      <h1>Parties at Little Adventure Town</h1>
      <p class="mt-4 max-w-xl text-xl text-navy-muted">
        Have the whole town to yourselves. Two hours, a table dressed in your theme, and food for the children. Come and have a proper do.
      </p>
    </header>

    <section class="mt-10" aria-labelledby="package-heading">
      <h2 id="package-heading">The party package</h2>
      <ul class="party-perks">
        {
          included.map((item) => (
            <li class="party-perk">
              <span class="party-perk-icon" aria-hidden="true">
                {item.icon === "clock" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8"></circle>
                    <path d="M12 7.8V12l3.2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                  </svg>
                )}
                {item.icon === "cake" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                    <path d="M5 20V11.5h14V20H5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    <path d="M5 11.5c1.6-1.2 3.2-1.8 7-1.8s5.4.6 7 1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    <path d="M9 7.2c0-1.2.8-2.2 1.6-3M12.4 7.2c0-1.2.8-2.2 1.6-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    <path d="M8 16.5h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                  </svg>
                )}
                {item.icon === "food" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                    <path d="M4.8 10.5h14.4v8.2a1.6 1.6 0 0 1-1.6 1.6H6.4a1.6 1.6 0 0 1-1.6-1.6v-8.2Z" stroke="currentColor" stroke-width="1.8"></path>
                    <path d="M8 10.5V8.2a4 4 0 0 1 8 0v2.3" stroke="currentColor" stroke-width="1.8"></path>
                  </svg>
                )}
                {item.icon === "balloon" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                    <ellipse cx="12" cy="9.2" rx="5.2" ry="6.4" stroke="currentColor" stroke-width="1.8"></ellipse>
                    <path d="M12 15.6c0 2.2-1.4 4.4.4 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                  </svg>
                )}
              </span>
              <div>
                <p class="party-perk-title">{item.title}</p>
                <p>{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="party-prices">
        <div class="party-invite">
          <p class="party-invite-kicker">Weekday</p>
          <p class="party-invite-price">{site.parties.weekdayPrice}</p>
          <p class="party-invite-note">Tuesday to Friday</p>
        </div>
        <div class="party-invite party-invite-weekend">
          <p class="party-invite-kicker">Weekend</p>
          <p class="party-invite-price">{site.parties.weekendPrice}</p>
          <p class="party-invite-note">Saturday and Sunday</p>
        </div>
      </div>
      <p class="mt-4">
        A {site.parties.deposit} deposit books it. The rest is due {site.parties.balanceDue}.
      </p>
    </section>

    <section class="mt-12" aria-labelledby="food-heading">
      <h2 id="food-heading">Food</h2>
      <p class="mt-3">Pick one for the children:</p>
      <div class="party-food">
        <article class="party-food-card">
          <h3>Sandwich box</h3>
          <p>{site.parties.sandwichBox}</p>
        </article>
        <article class="party-food-card">
          <h3>Hot meal</h3>
          <p>{site.parties.hotMeal}</p>
        </article>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="themes-heading">
      <h2 id="themes-heading">Themes</h2>
      <ul class="party-themes" aria-label="Party themes">
        {
          site.parties.themes.map((theme) => (
            <li>{theme}</li>
          ))
        }
      </ul>
      <p class="mt-4">
        Mickey and Minnie with mascots is an extra {site.parties.mascotExtra}. {site.parties.otherThemesNote}
      </p>
    </section>

    <section class="mt-12" aria-labelledby="extras-heading">
      <h2 id="extras-heading">Extras</h2>
      <p class="mt-3">{site.parties.extrasNote}</p>
    </section>

    <div class="mt-12">
      <h2>Ask about a party</h2>
      <p class="mt-3 mb-6">
        {site.parties.enquiryNote} If you’d rather message, <a class="font-bold underline underline-offset-2" href="/contact">use the contact page</a> or <a class="font-bold underline underline-offset-2" href={site.social.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>.
      </p>
      <EnquiryForm formName="party-enquiry" extraFields="party" submitLabel="Send party enquiry" />
    </div>
  </article>
</BaseLayout>
