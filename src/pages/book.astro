---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import BookwhenEmbed from "../components/BookwhenEmbed.astro";
import DealBadge from "../components/DealBadge.astro";
import { childPriceLine, site } from "../config/site";
---

<BaseLayout page="book" stickyCta={false}>
  <article class="mx-auto max-w-5xl px-4 py-10 md:px-6 md:py-16">
    <PageHero eyebrow="Bishop Auckland" accent="pink" mark="★">
      <h1 slot="title">Book a play session</h1>
      <p>
        {site.play.durationLabel}. {childPriceLine()}. Adults go free. {site.hours.days}. You’ll need to book a sitting before you come.
      </p>
    </PageHero>

    <dl class="book-stat-grid">
      <div class="story-card" style="--story: var(--color-pink)">
        <dt class="text-sm font-bold uppercase tracking-wide text-navy-muted">Days</dt>
        <dd class="mt-1 font-display text-2xl">{site.hours.days}</dd>
      </div>
      <div class="story-card" style="--story: var(--color-teal)">
        <dt class="text-sm font-bold uppercase tracking-wide text-navy-muted">Sittings</dt>
        <dd class="book-sittings">
          {
            site.play.sessions.map((session, index) => (
              <p>
                <span class="book-sitting-num" aria-hidden="true">{index + 1}</span>
                <span class="book-sitting-time">
                  <strong>{session.start}</strong>
                  <span> to {session.end}</span>
                </span>
              </p>
            ))
          }
        </dd>
      </div>
      <div class="story-card book-price-card" style="--story: var(--color-meadow)">
        <dt class="text-sm font-bold uppercase tracking-wide text-navy-muted">Price</dt>
        <dd class="mt-2">
          <DealBadge />
        </dd>
        <dd class="mt-1 font-display text-2xl">{site.play.pricePerChild} <span class="text-lg font-body font-bold">a child, all September</span></dd>
      </div>
    </dl>

    <div class="book-notes">
      <section class="card book-note" style="border-top: 8px solid var(--color-pink)" aria-labelledby="expect-heading">
        <h2 id="expect-heading">What to expect</h2>
        <ul class="icon-lines">
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="13" r="7.4" stroke="currentColor" stroke-width="1.7"></circle>
                <path d="M9.2 3.4h5.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                <path d="M12 3.4v2.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                <path d="M12 13V8.8M12 13l3.6 2.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                <circle cx="12" cy="13" r="1.15" fill="currentColor"></circle>
                <path d="M12 6.6v.9M12 18.5v.9M6.1 13h.9M17 13h.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
            </span>
            <span>You book a 90-minute sitting. Arrive for the start so the rooms stay calm between sittings.</span>
          </li>
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M3.4 20.4V10.6h2.1V8.2h2.1v2.4h1.5V6.2h2V4.2h2.1V6.2h2v4.4h1.5V8.2h2.1v2.4h2.1v9.8H3.4Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <path d="M10.2 20.4v-4.8c0-1.7 3.6-1.7 3.6 0v4.8" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <path d="M14.1 6.2V3.6h3.8l-1.1 1.15 1.1 1.45h-3.8" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span>The town is themed play, not a multi-storey frame: Under the Sea, The Beach, Dinosaur Volcano, The Castle, The Farm Barn, and Sensory Space.</span>
          </li>
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <circle cx="8.4" cy="6.8" r="2.35" stroke="currentColor" stroke-width="1.65"></circle>
                <circle cx="15.8" cy="8.6" r="1.85" stroke="currentColor" stroke-width="1.65"></circle>
                <path d="M4.2 20.2c.35-3.1 2.2-5 4.4-5 2.1 0 3.7 1.5 4.4 4.2" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"></path>
                <path d="M13.6 20.2c.3-2.2 1.6-3.5 3.1-3.5 1.5 0 2.8 1.1 3.2 3.2" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"></path>
                <path d="M11.6 14.4 14.8 12" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"></path>
              </svg>
            </span>
            <span>An adult stays with their child for the whole sitting.</span>
          </li>
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M8.4 3.6h4.1v8.2l3.8 3.6c1.35 1.3 1.2 3.5-.35 4.5-1.4.9-3.35.45-4.4-.7L8.4 15.6V3.6Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <path d="M8.4 6.4h4.1M8.4 8.6h4.1" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
                <path d="M5.6 5.2h2.2v9.4L5.4 17c-.9.85-.8 2.3.3 2.95 1 .6 2.35.25 3.05-.55" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span>Shoes off, socks on. Grown-ups too.</span>
          </li>
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M6.4 9.2h9.2v8.6c0 1.1-.9 2-2 2H8.4c-1.1 0-2-.9-2-2V9.2Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <path d="M15.6 11h2.4a2.15 2.15 0 1 1 0 4.3h-2.4" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <path d="M9.2 5.4c.35-1.35 1.15-1.4 1.55 0M12.6 5.2c.35-1.35 1.15-1.4 1.55 0" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
                <path d="M8.6 13.2h4.8" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
              </svg>
            </span>
            <span>{site.cafe.walkInNote}</span>
          </li>
        </ul>
      </section>

      <section class="card book-note" style="border-top: 8px solid var(--color-meadow)" aria-labelledby="included-heading">
        <h2 id="included-heading">What’s included</h2>
        <ul class="icon-lines">
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M4.6 16.8c2.4-2.1 4.4-3.4 7.4-3.4s5 1.3 7.4 3.4" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"></path>
                <circle cx="6.6" cy="16.8" r="1.35" fill="currentColor"></circle>
                <circle cx="12" cy="13.4" r="1.35" fill="currentColor"></circle>
                <circle cx="17.4" cy="16.8" r="1.35" fill="currentColor"></circle>
                <path d="M12 13.4V8.2" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"></path>
                <path d="M12 4.4 13.15 7.1h2.85l-2.3 1.7.85 2.75L12 9.95 9.45 11.55l.85-2.75-2.3-1.7h2.85L12 4.4Z" fill="currentColor"></path>
              </svg>
            </span>
            <span>Play across the zones for your booked sitting.</span>
          </li>
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 2.5c2.2 3.8 2.8 7.8 2.8 12.2H9.2C9.2 10.3 9.8 6.3 12 2.5Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <circle cx="12" cy="9.2" r="1.4" fill="currentColor"></circle>
                <path d="M9.2 13.4 5.7 18.6 9.2 16.6M14.8 13.4 18.3 18.6 14.8 16.6" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <path d="M10.3 16.2 12 21 13.7 16.2" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span>Use of Sensory Space during ordinary sittings.</span>
          </li>
          <li>
            <span class="icon-lines-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M4.2 7.2h15.6v4.1c-1.15 0-2.05.9-2.05 2s.9 2 2.05 2v4.3H4.2v-4.3c1.15 0 2.05-.9 2.05-2s-.9-2-2.05-2V7.2Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"></path>
                <path d="M14.6 7.2v12.4" stroke="currentColor" stroke-width="1.65" stroke-dasharray="1.6 1.7" stroke-linecap="round"></path>
                <path d="M6.6 10.2h5.4M6.6 13.1h3.6" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
              </svg>
            </span>
            <span>Adults go free.</span>
          </li>
        </ul>
        <p class="book-note-foot">
          Need a quieter visit or an adjustment? <a class="font-bold underline underline-offset-2" href="/contact">Tell us beforehand</a> and we’ll be honest about what we can do.
        </p>
      </section>
    </div>

    <aside class="story-card mt-12" style="--story: var(--color-teal)" aria-labelledby="quantity-heading">
      <h2 id="quantity-heading" class="text-2xl">Booking more than one child?</h2>
      <p class="mt-2">
        Change the quantity on the sitting rather than making two bookings. That’s how siblings get on the same slot.
      </p>
      <p class="mt-2 text-navy-muted">
        Socks on for everyone on the play floor, grown-ups too. An adult stays with their child. Pick a sitting below, and you’re sorted.
      </p>
    </aside>

    <div class="mt-6">
      <BookwhenEmbed />
    </div>

    <section class="mt-12 story-card" style="--story: var(--color-pink)" aria-labelledby="cancel-heading">
      <h2 id="cancel-heading">Cancellations</h2>
      <p class="mt-3">
        {site.policies.cancellation} If we have to cancel, you’ll get a full refund or a move to another day, whichever suits you best.
      </p>
      <p class="mt-4">
        Payments are processed by Stripe through Bookwhen. We do not take card details on this website.
      </p>
      <p class="mt-4">
        By booking you agree to the <a class="font-bold underline underline-offset-2" href="/conditions">conditions of entry</a>.
      </p>
    </section>
  </article>
</BaseLayout>

