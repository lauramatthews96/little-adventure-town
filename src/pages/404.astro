---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Little Adventure Town" description="That page isn’t in the town. Head home or book a session at Little Adventure Town in Bishop Auckland." path="/404" noindex>
  <article class="mx-auto max-w-3xl px-4 py-16 md:px-6">
    <p class="eyebrow">Wrong turning</p>
    <h1>This street doesn’t exist.</h1>
    <p class="mt-4 text-xl text-navy-muted">The page you asked for isn’t on the site. The booking button still is.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/book">Book a session</a>
      <a class="btn btn-secondary" href="/">Back to the town</a>
    </div>
  </article>
</BaseLayout>
