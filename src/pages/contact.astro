---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import ToConfirm from "../components/ToConfirm.astro";
import { formatAddress, isToConfirm, site } from "../config/site";

const sent = Astro.url.searchParams.get("sent") === "1";
---

<BaseLayout page="contact">
  <article class="mx-auto max-w-3xl px-4 py-10 md:px-6 md:py-16">
    <p class="eyebrow">Bishop Auckland</p>
    <h1>Contact</h1>
    <p class="mt-4 text-xl text-navy-muted">
      Questions about parties, SEND, or just wanting to say hello. If you’re booking a sitting, <a class="font-bold underline underline-offset-2" href="/book">go to the booking page</a>. This form isn’t a booking.
    </p>

    {
      sent && (
        <p class="mt-6 rounded-[1.25rem] border-2 border-teal bg-[#e7f6f4] p-4 font-bold" role="status">
          Thank you. We’ve got your message and we’ll reply as soon as we can.
        </p>
      )
    }

    <section class="mt-10" aria-labelledby="direct-heading">
      <h2 id="direct-heading">Direct details</h2>
      <ul class="mt-4 space-y-2">
        <li>{formatAddress()}</li>
        <li>Email: {isToConfirm(site.contact.email) ? <ToConfirm /> : <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}</li>
        <li>
          Instagram: <a class="font-bold underline underline-offset-2" href={site.social.instagramUrl}>{site.social.instagramHandle}</a>
        </li>
        <li>
          Facebook: <a class="font-bold underline underline-offset-2" href={site.social.facebookUrl}>{site.social.facebookName}</a>
        </li>
      </ul>
      <p class="mt-3">{site.contact.contactNote}</p>
    </section>

    <div class="mt-12">
      <h2>Send a message</h2>
      <p class="mt-3 mb-6">For adjustments, tell us what usually helps. We read these as people, not as a ticket queue.</p>
      <EnquiryForm formName="contact" submitLabel="Send message" />
    </div>
  </article>
</BaseLayout>
