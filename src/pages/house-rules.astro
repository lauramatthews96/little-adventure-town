---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
---

<BaseLayout page="houseRules">
  <article class="prose-page mx-auto px-4 py-10 md:px-6 md:py-16">
    <PageHero eyebrow="The short list" accent="meadow" mark="★">
      <h1 slot="title">House rules</h1>
      <p>A calmer room for everyone. Last updated 21 August 2026.</p>
    </PageHero>

    <h2>Socks</h2>
    <p>
      Shoes off, socks on for everyone on the play floor, including adults.
    </p>

    <h2>Supervision</h2>
    <p>
      Children must be supervised by an adult at all times. Staff are here to run the rooms, not to babysit. Adults go free.
    </p>

    <h2>Booking</h2>
    <p>
      Play is booked. There is no walk-in general admission.
    </p>

    <h2>Food and allergens</h2>
    <p>
      There is a café on site. {site.cafe.walkInNote} {site.policies.ownFood} {site.policies.allergen}
    </p>

    <h2>Buggies</h2>
    <p>
      {site.policies.buggies}
    </p>

    <h2>The rooms</h2>
    <p>
      Be kind to the paintwork and to other families. No climbing on things that are not for climbing. The sensory room is a quiet place. Keep voices and devices down in there.
    </p>

    <h2>Illness</h2>
    <p>
      Please do not come if your child is infectious. {site.policies.cancellation}
    </p>

    <p class="mt-8">
      Questions: <a class="font-bold underline underline-offset-2" href="/faq">FAQs</a> or <a class="font-bold underline underline-offset-2" href="/contact">contact</a>.
    </p>
  </article>
</BaseLayout>
