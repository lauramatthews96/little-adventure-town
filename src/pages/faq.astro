---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaPanel from "../components/CtaPanel.astro";
import { faqGroups, faqs, faqPlainAnswer, site } from "../config/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faqPlainAnswer(item.answer),
    },
  })),
};
---

<BaseLayout page="faq">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="faq-page mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-16">
    <header class="faq-hero">
      <div class="faq-confetti" aria-hidden="true">
        <span class="faq-float faq-float-1">?</span>
        <span class="faq-float faq-float-2">?</span>
        <span class="faq-float faq-float-3">?</span>
        <span class="faq-float faq-float-4">?</span>
        <span class="faq-float faq-float-5">?</span>
        <span class="faq-float faq-float-6">?</span>
      </div>
      <p class="eyebrow">Straight answers</p>
      <h1>Questions? We’ve got a cuppa and a minute.</h1>
      <p class="faq-lede">
        Booking, socks, the café, SEN, parties, and how to find us on Newgate Street. If it isn’t here, <a href="/contact">drop us a message</a> and we’ll sort it.
      </p>
    </header>

    <div class="faq-layout">
      <nav class="faq-jump" aria-label="FAQ topics">
        <p class="faq-jump-label">Jump to</p>
        <ul>
          {
            faqGroups.map((group) => (
              <li>
                <a class={`faq-jump-link faq-jump-${group.accent}`} href={`#${group.id}`}>
                  <span class="faq-jump-q" aria-hidden="true">?</span>
                  {group.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="faq-groups">
        {
          faqGroups.map((group) => (
            <section class={`faq-section faq-section-${group.accent}`} id={group.id} aria-labelledby={`${group.id}-heading`}>
              <header class="faq-section-head">
                <span class="faq-section-icon" aria-hidden="true">
                  {group.id === "booking" && (
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                      <rect x="3.5" y="6" width="17" height="13.5" rx="2.2" stroke="currentColor" stroke-width="1.8"></rect>
                      <path d="M7 6V4.8M17 6V4.8M3.5 10h17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                      <path d="M8 13.5h3.5M8 16.2h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                  )}
                  {group.id === "your-visit" && (
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                      <path d="M4.5 20V10.5L12 5l7.5 5.5V20" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <path d="M9.5 20v-6h5v6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    </svg>
                  )}
                  {group.id === "food-and-drink" && (
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                      <path d="M6.5 9h9.2a3.3 3.3 0 0 1 0 6.6H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                      <path d="M6.5 9c0 4 0 8.5 3.8 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                      <path d="M8.2 4.8c.4 1.3 1.3 1.9 2.5 1.9s2-.6 2.4-1.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                  )}
                  {group.id === "accessibility" && (
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                      <path d="M12 2.6c2.25 3.9 2.85 8.1 2.85 12.6H9.15C9.15 10.7 9.75 6.5 12 2.6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <circle cx="12" cy="9.4" r="1.45" fill="currentColor"></circle>
                    </svg>
                  )}
                  {group.id === "parties-and-classes" && (
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                      <ellipse cx="9" cy="8.5" rx="4" ry="5.2" stroke="currentColor" stroke-width="1.8"></ellipse>
                      <ellipse cx="15.5" cy="9.6" rx="3.2" ry="4.4" stroke="currentColor" stroke-width="1.8"></ellipse>
                      <path d="M9 13.8c0 3-1.2 5.2.6 7.4M15.5 14.1c.6 2.8-.4 5 1.4 7.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                  )}
                  {group.id === "anything-else" && (
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                      <path d="M12 20.5s7-4.2 7-10.1A7 7 0 0 0 5 10.4C5 16.3 12 20.5 12 20.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <circle cx="12" cy="10.2" r="2.1" stroke="currentColor" stroke-width="1.8"></circle>
                    </svg>
                  )}
                </span>
                <div>
                  <h2 id={`${group.id}-heading`}>{group.title}</h2>
                  <p class="faq-section-blurb">{group.blurb}</p>
                </div>
              </header>

              <div class="faq-list">
                {group.items.map((item, index) => (
                  <details class="faq-item" open={index === 0}>
                    <summary>
                      <span class="faq-mark" aria-hidden="true">?</span>
                      <span class="faq-question">{item.question}</span>
                    </summary>
                    <div class="faq-answer" set:html={`<p>${item.answer}</p>`} />
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <aside class="faq-still-stuck">
      <span class="faq-still-q" aria-hidden="true">?</span>
      <div>
        <h2>Still stuck?</h2>
        <p>
          A message on <a href={site.social.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a> is the quickest, or email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>. You can also read the <a href="/conditions">conditions of entry</a>, <a href="/house-rules">house rules</a> and <a href="/booking-terms">booking terms</a>.
        </p>
      </div>
    </aside>

    <CtaPanel heading="Ready for a sitting?" />
  </article>
</BaseLayout>
