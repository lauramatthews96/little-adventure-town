---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";
import MobileStickyCta from "../components/MobileStickyCta.astro";
import JsonLd from "../components/JsonLd.astro";
import OpeningBanner from "../components/OpeningBanner.astro";
import { site, pages, hero } from "../config/site";

type PageKey = keyof typeof pages;

interface Props {
  page?: PageKey;
  title?: string;
  description?: string;
  path?: string;
  stickyCta?: boolean;
  noindex?: boolean;
}

const {
  page,
  title = page ? pages[page].title : pages.home.title,
  description = page ? pages[page].description : pages.home.description,
  path = page ? pages[page].path : "/",
  stickyCta = true,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).toString();
const ogImage = new URL(hero.shareImage, site.url).toString();
const showSticky = stickyCta && path !== "/book";
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/og-default.png" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={hero.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <JsonLd />
  </head>
  <body class:list={[showSticky && "has-sticky-book"]}>
    <SkipLink />
    <OpeningBanner />
    <div class="site-ribbon" aria-hidden="true"></div>
    <Header currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <div class="site-ribbon" aria-hidden="true"></div>
    <Footer />
    {showSticky && <MobileStickyCta />}
  </body>
</html>
